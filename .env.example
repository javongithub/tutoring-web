NODE_ENV=production
PORT=3001
# Long random values. Generate with: openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=
DB_PATH=data/tutoring.db
TZ_NAME=America/Los_Angeles
# Behind Caddy/nginx so rate limiting sees real client IPs
TRUST_PROXY=loopback
# Optional: instant push to Google Calendar (JSON key contents, or a path to the file)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: AI-drafted progress reports (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
